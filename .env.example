# -----------------------------------------------------------------------------
# Unravel Decryption, Parser & Broker Service Configuration
# -----------------------------------------------------------------------------
UNRAVEL_PORT=8001
UNRAVEL_HOST=0.0.0.0
UNRAVEL_DB_PATH=/app/data/unravel.db

# -----------------------------------------------------------------------------
# Admin Authentication Configuration (.env dictates what is available)
# NOTE: Other use of the platform (decryption, parsing, schema fetching,
# broker dispatch, telemetry ingest) is unauthenticated and open to all users.
# Only the Admin Dashboard and schema mutation operations require authentication.
# -----------------------------------------------------------------------------

# 1. Master Token / Password Authentication
UNRAVEL_AUTH_MASTER_ENABLED=true
UNRAVEL_MASTER_PASSWORD=unravel2026

# 2. IIS X-Header Authentication (Windows Authentication / Kerberos / NTLM through IIS)
# When behind an IIS reverse proxy (ARR/URL Rewrite), IIS passes the authenticated Windows username.
UNRAVEL_AUTH_IIS_HEADER_ENABLED=false
UNRAVEL_AUTH_IIS_HEADER_NAME=X-Remote-User
# Comma-separated list of allowed Windows/IIS usernames (case-insensitive, e.g. DOMAIN\user, user)
UNRAVEL_AUTH_IIS_ALLOWED_USERS=DOMAIN\admin,DOMAIN\ashley,admin,ashley

# 3. LDAP / Active Directory (LDAPS) Authentication
UNRAVEL_AUTH_LDAP_ENABLED=false
UNRAVEL_AUTH_LDAP_SERVER=ldaps://ad.enterprise.org:636
UNRAVEL_AUTH_LDAP_BASE_DN=DC=enterprise,DC=org
# User DN Template or User Principal Name format (e.g. {username}@enterprise.org or uid={username},ou=users,dc=enterprise,dc=org)
UNRAVEL_AUTH_LDAP_USER_DN_TEMPLATE={username}@enterprise.org
# Optional Service Bind Account (used for group membership search if user cannot self-query)
UNRAVEL_AUTH_LDAP_BIND_DN=
UNRAVEL_AUTH_LDAP_BIND_PASSWORD=
# Optional Active Directory Group Filter (user must be member of this group to administer dashboard)
UNRAVEL_AUTH_LDAP_GROUP_FILTER=CN=UnravelAdmins,OU=Groups,DC=enterprise,DC=org
UNRAVEL_AUTH_LDAP_USE_SSL=true
# Set to true for mock/testing mode without an active LDAP server
UNRAVEL_AUTH_LDAP_MOCK=false
